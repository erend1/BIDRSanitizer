# Normalize text files in Git.
* text=auto

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary document/image formats.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.doc binary
*.docx binary
*.onnx binary
*.safetensors binary
*.pdiparams binary