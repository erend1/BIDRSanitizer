{
  "name": "bidr-sanitizer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development --config webpack.config.cjs",
    "build": "tsc -b && webpack --mode production --config webpack.config.cjs",
    "typecheck": "tsc -b --pretty false",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "dev:vite": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build:vite": "tsc -b && vite build",
    "test:vitest": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@rolldown/binding-wasm32-wasi": "1.2.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.4",
    "html-webpack-plugin": "5.6.8",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jsdom": "30.0.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "7.0.2",
    "undici": "8.10.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0",
    "whatwg-fetch": "3.6.20"
  }
}
